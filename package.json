{
  "name": "gearlabgaming",
  "version": "1.0.0",
  "private": true,
  "description": "GearLabGaming - Gaming Gear Reviews & Guides CMS",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:create-migration": "wrangler d1 migrations create DB",
    "type-check": "tsc --noEmit",
    "seed": "tsx scripts/seed-admin.ts",
    "seed:seo": "tsx scripts/seed-seo-content.ts",
    "upgrade:content": "tsx scripts/upgrade-indexable-content.ts",
    "add:chairs-desks": "tsx scripts/add-chairs-desks-content.ts",
    "add:core-products": "tsx scripts/add-core-products.ts",
    "enrich:core-products": "tsx scripts/enrich-core-products.ts",
    "indexnow:submit": "tsx scripts/submit-indexnow.ts",
    "audit:meta": "tsx scripts/audit-meta-descriptions.ts",
    "update:affiliate": "tsx scripts/update-affiliate-links.ts"
  },
  "dependencies": {
    "@sonicjs-cms/core": "^2.19.0",
    "hono": "^4.13.11",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250620.0",
    "@types/node": "^20.19.1",
    "bcrypt": "^6.0.0",
    "drizzle-kit": "^0.30.0",
    "drizzle-orm": "^0.44.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.59.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
